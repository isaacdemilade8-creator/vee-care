# Optional override for the API base URL. When unset, development derives it
# from the page hostname (http://<page-host>:8000/api) so every tenant host
# reaches its own API Host and the backend resolver stays authoritative.
# Set this explicitly for production/deployments where the API lives on a
# separate domain, e.g.:
# VITE_API_BASE_URL=https://api.vee-care.test/api

# Required for realtime chat, typing indicators, and live notifications.
# Copy PUSHER_APP_KEY and PUSHER_APP_CLUSTER from backend/.env or your Pusher Channels app keys page.
VITE_PUSHER_APP_KEY=
VITE_PUSHER_APP_CLUSTER=mt1
