APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:5173
BROADCAST_CONNECTION=pusher

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# The control (platform) database. Used for the default connection and by
# all control-plane models (tenants, tenant_domains, platform users).
DB_DATABASE=vee_care_control
DB_USERNAME=root
DB_PASSWORD=

# Control database (defaults to DB_* above when omitted).
# CONTROL_DB_CONNECTION=mysql
# CONTROL_DB_HOST=127.0.0.1
# CONTROL_DB_PORT=3306
# CONTROL_DB_DATABASE=vee_care_control
# CONTROL_DB_USERNAME=root
# CONTROL_DB_PASSWORD=

# ---------------------------------------------------------------------------
# Multi-tenancy
# ---------------------------------------------------------------------------
# The apex/platform domain. Tenant requests use <slug>.<platform_domain>.
TENANT_PLATFORM_DOMAIN=vee-care.test
# Subdomains of the platform domain that belong to the control plane.
TENANT_PLATFORM_SUBDOMAINS=api,admin,www
# Prefix used when generating tenant database names.
TENANT_DB_PREFIX=vee_care_tenant_
# Driver used for tenant databases. Leave empty to use DB_CONNECTION.
# Set to "sqlite" for tenant databases stored as files (local/testing).
# TENANT_DB_DRIVER=mysql
# Default credentials applied when a tenant record does not override them.
# TENANT_DB_HOST=127.0.0.1
# TENANT_DB_PORT=3306
# TENANT_DB_USERNAME=root
# TENANT_DB_PASSWORD=
# Base directory for sqlite tenant databases.
TENANT_DB_PATH=database/tenants

# Platform administrator seeded by `php artisan db:seed`.
# PLATFORM_ADMIN_EMAIL=super@vee-care.test
# PLATFORM_ADMIN_PASSWORD=password

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
